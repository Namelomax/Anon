# Скопировать на сервер как /etc/anonymizer.env и закрыть права:
#
#   sudo install -m 600 -o root -g root anonymizer.env.example /etc/anonymizer.env
#   sudo nano /etc/anonymizer.env      # вписать настоящий ключ
#
# ВАЖНО: ключ передаётся ТОЛЬКО через этот файл, никогда через аргументы
# командной строки. Аргументы видны в `ps aux` любому пользователю системы, а
# на этом хосте есть учётки deploy и другие. У всех параметров server.py есть
# дефолты из окружения ровно ради этого.

# --- LLM ------------------------------------------------------------------
ANONYMIZER_LLM_BASE_URL=https://oui.interfonica.cloud/v1
ANONYMIZER_LLM_MODEL=gemma-4-31b
ANONYMIZER_LLM_API_KEY=ЗАМЕНИТЬ_НА_НОВЫЙ_КЛЮЧ
# Размер куска текста (в символах) на один запрос детекции (LLMConfig.max_chars).
# Компромисс скорость/стоимость против recall: БОЛЬШЕ — меньше запросов и
# меньше повторов системного промпта (~1123 токена каждый), то есть дешевле и
# быстрее (на 30-страничной расшифровке 3000 -> 6000 сократило входные токены
# примерно со 160к до 131к, около -18% стоимости документа, и на пару секунд
# быстрее); МЕНЬШЕ — выше recall: модель видит меньше текста за раз и реже
# пропускает склонённые формы (например «Лентой» — без regex-подстраховки на
# чанке 3000 терялось). 3000 — измеренное компромиссное значение, дефолт;
# менять только после сравнения на реальных документах.
ANONYMIZER_LLM_MAX_CHARS=3000

# --- GLiNER ---------------------------------------------------------------
# База БЕЗ /extract на конце. Ключ можно не задавать: пустое значение означает
# «использовать ANONYMIZER_LLM_API_KEY», один ключ обслуживает оба эндпоинта.
ANONYMIZER_GLINER_URL=https://oui.interfonica.cloud/gliner
ANONYMIZER_GLINER_API_KEY=

# --- Пул HTTP-соединений (http_pool.py) ------------------------------------
# Верхний предел ОДНОВРЕМЕННЫХ запросов к вышестоящим моделям СРАЗУ ПО ВСЕМ
# документам в процессе — не per-document. Нужен потому, что параллельность в
# одном документе (пулы потоков llm.py/gliner_remote.py) умножается на число
# документов, обрабатываемых одновременно, а сам шлюз проверенно ломается не
# от числа запросов, а от ВСПЛЕСКА НОВЫХ соединений — держать много
# одновременных запросов на уже установленных (переиспользуемых) соединениях
# он способен.
#
# ДВА НЕЗАВИСИМЫХ предела, а не один общий, потому что у чат-вызовов (LLM
# детекция и все слои ревью) и вызовов GLiNER совершенно разное время
# удержания слота: чат-вызов держит слот ~12 СЕКУНД, вызов GLiNER /extract —
# ~70 МИЛЛИСЕКУНД. Один общий семафор позволил бы всплеску долгих чат-вызовов
# занять все слоты и заставил бы короткие GLiNER-вызовы вставать в очередь за
# ними — ~8-секундный этап GLiNER превратился бы в минуты, стоит ему
# совпасть по времени с этапом LLM другого документа. Это именно тот
# многодокументный сценарий, ради которого предел вообще существует (внутри
# одного документа этапы и так идут последовательно, конкуренции нет).
#
# ANONYMIZER_MAX_INFLIGHT — предел для чат-вызовов (llm.py, review.py). По
# умолчанию 24.
ANONYMIZER_MAX_INFLIGHT=24
# ANONYMIZER_MAX_INFLIGHT_GLINER — предел для вызовов удалённого GLiNER
# (gliner_remote.py). По умолчанию 16 (совпадает с RemoteGLiNERConfig.concurrency).
ANONYMIZER_MAX_INFLIGHT_GLINER=16

# --- Учёт использования (usage_log.py) -------------------------------------
# Путь к JSONL-логу вызовов моделей (токены, время, стоимость). Пусто —
# значит дефолт: <корень репо>/logs/usage.jsonl.
ANONYMIZER_USAGE_LOG=
# Цена за 1M токенов в рублях, вход/выход. Дефолт — тариф Selectel Gemma 4 31B.
ANONYMIZER_PRICE_IN_PER_MTOK=14.79
ANONYMIZER_PRICE_OUT_PER_MTOK=43.15
# Цена за 1M токенов удалённого GLiNER (gliner_remote.py), ₽. Тот же
# провайдер и тот же биллинг по токенам, что и LLM, но GLiNER-эндпоинт не
# присылает usage-блок в ответе — его токены НЕЛЬЗЯ измерить, только
# оценить (см. три переменные ниже). Дефолт — цена входных токенов LLM:
# консервативный выбор, малая модель классификации вряд ли стоит дороже
# входа большой.
ANONYMIZER_PRICE_GLINER_PER_MTOK=14.79
# Калибровочные коэффициенты оценки токенов GLiNER — GLiNER биллится тем же
# провайдером по токенам, но его HTTP-ответ не несёт usage/prompt_tokens, а
# значит cost_rub без этой оценки занижает реальный счёт примерно на 19%
# входного объёма. Оценка: tokens ≈ chars / ANONYMIZER_CHARS_PER_TOKEN +
# ANONYMIZER_GLINER_TOKENS_PER_CALL, где chars — то, что record_call уже
# логирует на каждый вызов GLiNER. Это КАЛИБРОВОЧНЫЕ ЗНАЧЕНИЯ, а не точные
# константы: когда придёт первый настоящий счёт от провайдера за GLiNER,
# подправить нужно ровно эти два числа, и журнал станет точным.
#
# ANONYMIZER_CHARS_PER_TOKEN — символов на один токен GLiNER. Дефолт 2.27
# измерен на этом корпусе: собственные prompt_tokens LLM минус системные
# промпты, делённые на отправленные символы, на документе 73 321 символ.
ANONYMIZER_CHARS_PER_TOKEN=2.27
# ANONYMIZER_GLINER_TOKENS_PER_CALL — токены накладных расходов на КАЖДЫЙ
# вызов GLiNER: список меток (person/first name/last name/nickname/
# location/address/organization) плюс JSON-обвязка запроса едут в каждом
# запросе независимо от длины текста. Это не мелочь для округления: на
# 30-страничном документе это 7120 токенов из 39381 токена GLiNER, то есть
# 18% всех токенов GLiNER. Дефолт 20.
ANONYMIZER_GLINER_TOKENS_PER_CALL=20
# Построчное логирование ОТДЕЛЬНЫХ вызовов вышестоящих моделей (помимо
# итоговой строки kind=request_total на документ, которая пишется всегда).
# errors (дефолт) — строка только для неудачных вызовов (ok=false), чтобы в
#   логе была диагностика сбоев без раздувания файла успешными вызовами
#   (GLiNER-слой один делает сотни вызовов на документ, они не биллятся
#   токенами и уже полностью видны в request_total);
# all — старое поведение: строка на КАЖДЫЙ вызов, для отладки;
# off — не писать отдельные строки вообще, даже для ошибок.
ANONYMIZER_USAGE_LOG_CALLS=errors
