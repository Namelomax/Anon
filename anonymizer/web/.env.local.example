# Скопируйте в .env.local и при необходимости измените.

# URL Python-бэкенда (server.py с эндпоинтом /anonymize-file).
# Локальный тест: ваш server.py на 127.0.0.1:8000 (LLM указывает на LM Studio).
ANONYMIZER_BACKEND_URL=http://127.0.0.1:8000

# Bearer-токен бэкенда. Для локального теста не нужен (оставьте пустым).
# Для удалённого бэкенда (JupyterHub-прокси) укажите токен здесь — он
# подставляется на сервере и не попадает в браузер.
ANONYMIZER_BACKEND_KEY=

# Требовать ли вход (сессию Auth.js) на /api/anonymize и /api/deanonymize.
# По умолчанию (переменная не задана) — ТРЕБУЕТСЯ. Установите "false" ТОЛЬКО
# на время переходного периода (например, пока фронтенд ещё не обвязан
# формой логина) — при "false" маршруты анонимизации открыты ЛЮБОМУ, кто до
# них достучится, БЕЗ привязки к аккаунту и БЕЗ проверки квоты (см.
# lib/quota.ts): такой запрос тратит апстрим-бюджет владельца сервиса так,
# будто платит сам владелец. Не держите "false" на проде дольше, чем
# необходимо для переключения.
ANONYMIZER_REQUIRE_AUTH=true

# Путь к биллинговому JSONL-логу Python-бэкенда (см. anonymizer/usage_log.py)
# — источник истины для факта расхода квоты (lib/usage-import.ts читает его
# напрямую, т.к. фронтенд и бэкенд работают на одном хосте). По умолчанию
# (переменная не задана) используется "<корень репозитория>/logs/usage.jsonl"
# — тот же дефолт, что и на Python-стороне. На проде, если фронтенд и бэкенд
# запускаются из разных рабочих каталогов/деревьев (например, после сборки
# Next.js), укажите АБСОЛЮТНЫЙ путь явно — так же, как рекомендовано для
# DATABASE_URL выше.
ANONYMIZER_USAGE_LOG=

# --- База биллинга/авторизации (Prisma, SQLite) -----------------------------
# Файл БД содержит ПДн пользователей сервиса (email, хеш пароля) — по 152-ФЗ
# ч.5 ст.18 такая база ДОЛЖНА физически находиться на территории РФ и ВНЕ
# репозитория (личный компьютер разработчика для продуктива не годится — см.
# anonymizer/ЮРИДИЧЕСКИЕ_ДОКУМЕНТЫ/10_Авторизация_и_биллинг_правовая_фиксация.md,
# раздел 4). На проде указывайте абсолютный путь вне git-дерева, например
# /var/lib/anonymizer/billing.db. Для локальной разработки — синтетические
# данные, путь внутри prisma/ (файл всё равно в .gitignore).
#
# ВАЖНО про относительный путь: Prisma резолвит относительный sqlite-путь
# ОТНОСИТЕЛЬНО КАТАЛОГА schema.prisma (то есть уже "prisma/"), а не
# относительно cwd процесса — и так и в CLI (`prisma migrate dev`), и в
# рантайме (PrismaClient из lib/db.ts). Поэтому здесь "./dev.db", а НЕ
# "./prisma/dev.db" — иначе получится вложенный "prisma/prisma/dev.db"
# (было обнаружено на практике при первом запуске миграции: .gitignore
# защищает только "prisma/*.db", а не "prisma/prisma/*.db" — вложенный файл
# рисковал уйти в git при неосторожном "git add -A").
DATABASE_URL="file:./dev.db"

# Учётные данные единственного root-пользователя, создаваемого сидом
# (prisma/seed.ts). Обязательны — сид ОТКАЗЫВАЕТСЯ запускаться без них,
# захардкоженного пароля по умолчанию нет намеренно.
ROOT_EMAIL=
ROOT_PASSWORD=

# --- Auth.js (авторизация, см. auth.ts) --------------------------------------
# Секрет подписи/шифрования JWT-сессий. ГЕНЕРИРУЕТСЯ ОТДЕЛЬНО НА КАЖДОМ
# РАЗВЁРТЫВАНИИ (`npx auth secret` или `openssl rand -base64 32`) и НИКОГДА
# не коммитится: любой, кто знает AUTH_SECRET, может подделать сессионный
# JWT произвольного пользователя (включая role="root"). Пустое значение здесь
# — это placeholder, а не рабочий дефолт.
AUTH_SECRET=

# Версия редакции юридических документов (Политика обработки ПДн/Оферта, см.
# anonymizer/ЮРИДИЧЕСКИЕ_ДОКУМЕНТЫ/ГОТОВЫЕ_ДОКУМЕНТЫ/1_Политика_обработки_ПДн.md),
# под которой фиксируется согласие при регистрации (см. Consent.documentVersion
# в prisma/schema.prisma и /api/register). ОБНОВЛЯТЬ при каждой правке
# документа — иначе Consent-запись будет указывать не ту редакцию, которую
# фактически принял пользователь (см. раздел 9 п.2 правовой фиксации).
# По умолчанию (если переменная не задана) код использует "1.0".
LEGAL_DOCS_VERSION=1.0
